<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookkeeping.system.user.mapper.SysUserMapper">

    <resultMap id="SysUserResultMap" type="com.example.bookkeeping.system.user.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="phone" property="phone"/>
        <result column="status" property="status"/>
        <result column="last_login_at" property="lastLoginAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="BaseColumns">
        id, username, password, nickname, phone, status, last_login_at, created_at, updated_at, deleted
    </sql>

    <select id="selectById" resultMap="SysUserResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_user
        WHERE id = #{id}
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectByUsername" resultMap="SysUserResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM sys_user
        WHERE username = #{username}
          AND deleted = 0
        LIMIT 1
    </select>

    <update id="updateLastLoginAt">
        UPDATE sys_user
        SET last_login_at = #{lastLoginAt},
            updated_at = NOW()
        WHERE id = #{id}
          AND deleted = 0
    </update>

    <update id="updatePassword">
        UPDATE sys_user
        SET password = #{password},
            updated_at = NOW()
        WHERE id = #{id}
          AND deleted = 0
    </update>
</mapper>
